{
  "dashboard": {
    "title": "SoundMap Overview",
    "uid": "soundmap-main",
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timezone": "browser",
    "schemaVersion": 36,
    "annotations": {
      "list": []
    },
    "templating": {
      "list": []
    },
    "panels": [
      {
        "id": 1,
        "title": "Row 1: Ingest Pipeline",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
        "collapsed": false,
        "panels": []
      },
      {
        "id": 2,
        "title": "Readings Accepted (rate)",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(ingestor_readings_accepted_total[1m])",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "decimals": 2
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}
      },
      {
        "id": 3,
        "title": "Readings Rejected (rate)",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(ingestor_readings_rejected_total[1m])",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "decimals": 2,
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 10}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1}
      },
      {
        "id": 4,
        "title": "Active Streams",
        "type": "stat",
        "targets": [
          {
            "expr": "ingestor_active_streams",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1}
      },
      {
        "id": 5,
        "title": "Batch Size (p99)",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(ingestor_batch_size_bucket[5m]))",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1}
      },
      {
        "id": 6,
        "title": "Row 2: Analysis Pipeline",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
        "collapsed": false,
        "panels": []
      },
      {
        "id": 7,
        "title": "Analyzer Throughput",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(analyzer_readings_processed_total[1m])",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "opacity"
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6}
      },
      {
        "id": 8,
        "title": "Processing Latency p95",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(analyzer_processing_duration_ms_bucket[5m]))",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 6}
      },
      {
        "id": 9,
        "title": "Active BiDi Streams",
        "type": "stat",
        "targets": [
          {
            "expr": "analyzer_active_bidi_streams",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 6}
      },
      {
        "id": 10,
        "title": "Row 3: Alerts & Geo",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
        "collapsed": false,
        "panels": []
      },
      {
        "id": 11,
        "title": "Alert Subscribers",
        "type": "stat",
        "targets": [
          {
            "expr": "alert_subscribers_active",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 15}
      },
      {
        "id": 12,
        "title": "Alerts Fired (rate)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(alert_events_sent_total[1m])",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 50
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 15}
      },
      {
        "id": 13,
        "title": "Geo Cache Hit Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(geo_cache_hits_total[5m]) / (rate(geo_cache_hits_total[5m]) + rate(geo_cache_misses_total[5m]))",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.5},
                {"color": "green", "value": 0.8}
              ]
            },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 20
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 15}
      },
      {
        "id": 14,
        "title": "Row 4: gRPC Health",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
        "collapsed": false,
        "panels": []
      },
      {
        "id": 15,
        "title": "gRPC Error Rate by Service",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(grpc_server_handled_total{grpc_code!=\"OK\"}[1m])) by (job, grpc_method)",
            "legendFormat": "{{job}} / {{grpc_method}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 0.1}
              ]
            },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      }
    ]
  },
  "overwrite": true
}
